NEXT_PUBLIC_API_URL=http://localhost:4000

# Monad testnet (browser-side). Defaults documented in packages/config.
NEXT_PUBLIC_MONAD_RPC_URL=
NEXT_PUBLIC_MONAD_EXPLORER_URL=
# Demo AgentVault (docs/02) — deposit panel on agent 1's profile.
NEXT_PUBLIC_AGENT_VAULT_ADDRESS=
# DemoSwap panel (RETIRED — docs/11 v2).
NEXT_PUBLIC_DEMO_SWAP_ADDRESS=
# DemoFX agent-wallet corridor panel (docs/11 v3) — create/fund/release flow on agent 1's profile.
NEXT_PUBLIC_DEMO_FX_POOL_ADDRESS=

# Matches the API's data source so the UI banner reflects it (server-only,
# never exposed to the client bundle).
DATA_SOURCE=

# Dynamic (passkey wallets) — public env ID from app.dynamic.xyz dashboard
# (Developer -> Environment ID). Client-side value; still never commit real .env.
NEXT_PUBLIC_DYNAMIC_ENV_ID=
# Deployed AgentPassport (ERC-721) on Monad testnet — "passport minted" links.
# Defaults to the docs/02 deployment; override after redeploys.
NEXT_PUBLIC_AGENT_PASSPORT_ADDRESS=
