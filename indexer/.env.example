# Envio HyperSync API token — create at https://envio.dev/app/api-tokens
# Required for `pnpm dev` locally AND on Envio Cloud (set in dashboard, ENVIO_ prefix).
ENVIO_API_TOKEN=

# RPC for on-chain reads inside handlers (Effect API: agentOf / tokenURI / getAttestation).
# Locally this falls back to MONAD_TESTNET_RPC_URL from the repo-root .env.
ENVIO_MONAD_RPC_URL=
