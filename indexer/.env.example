# Envio HyperSync API token — create at https://envio.dev/app/api-tokens
# Required for `pnpm dev` locally AND on Envio Cloud (set in dashboard, ENVIO_ prefix).
ENVIO_API_TOKEN=

# RPC for on-chain reads inside handlers (Effect API: getAttestation, getPoolTokens).
# Locally this falls back to AVAX_FUJI_RPC_URL from the repo-root .env.
ENVIO_AVAX_FUJI_RPC_URL=
