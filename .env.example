# Lantern environment template.
# Copy to .env (gitignored — never commit real values).

# --- Backend API (apps/api) ---
PORT=4000
# Envio HyperIndex GraphQL endpoint (hosted URL from Envio Console, or local `envio dev` URL).
ENVIO_GRAPHQL_URL
ENVIO_API_TOKEN
ENVIO_MONAD_RPC_URL
ENVIO_ADMIN_SECRET
DATA_SOURCE
AGENT_VAULT_ADDRESS
AGENT_VAULT_AGENT_ID=

# --- Chat brains: OpenRouter (server-side only, never sent to the browser) ---
OPENROUTER_API_KEY=
CHAT_MODEL=openrouter/free

# --- Monad testnet: contracts (deployed 2026-10-10, chain 10143) ---
# Chain ID is read from the RPC at run time (never hardcoded).
MONAD_TESTNET_RPC_URL=
MONAD_PRIVATE_KEY=
# Set after running Deploy.s.sol — the seeder reads AGENT_REGISTRY_ADDRESS to know where to register.
AGENT_REGISTRY_ADDRESS=
AGENT_PASSPORT_ADDRESS=
REPUTATION_ADDRESS=
# DemoSwap demo protocol (deployed 2026-10-16, RETIRED — see DemoFX below).
DEMO_SWAP_ADDRESS=
MOCK_USDC_ADDRESS=
# DemoFX agent-wallet corridor (deployed 2026-10-18 by DeployDemoFX.s.sol — docs/11 v3).
DEMO_FX_POOL_ADDRESS=
MOCK_USD_ADDRESS=
MOCK_CNY_ADDRESS=
MOCK_SGD_ADDRESS=
# Chat persona fallback chain (comma-separated) — primary CHAT_MODEL first.
# Free-tier models rate-limit fast; the chain is walked on 429/5xx/timeouts.
CHAT_MODEL_FALLBACKS=
