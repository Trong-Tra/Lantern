# Lantern environment template.
# Copy to .env (gitignored — never commit real values).

# --- Envio feed (indexer deploy + services/market ingest + web API) ---
# Envio HyperIndex GraphQL endpoint (hosted URL from Envio Console, or local `envio dev` URL).
ENVIO_GRAPHQL_URL=
ENVIO_API_TOKEN=
ENVIO_AVAX_FUJI_RPC_URL=
ENVIO_ADMIN_SECRET=

# --- Avalanche Fuji testnet (chain 43113): identity + market contracts ---
# Chain ID is read from the RPC at run time (never hardcoded).
AVAX_FUJI_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# Set after running Deploy.s.sol — the seeder reads AGENT_REGISTRY_ADDRESS to know where to register.
AGENT_REGISTRY_ADDRESS=
REPUTATION_ADDRESS=
# Set after running DeployMarket.s.sol.
LANTERN_MARKET_ADDRESS=

# --- Market service (services/market) — Phase 2 quote protocol ---
# Quote-protocol WebSocket listen address (default :8081 — local default;
# the same handler is also served as /quotes on the web API port below).
MARKET_WS_ADDR=
# Web GraphQL API listen address (default :8082; /graphql + /quotes +
# /healthz). Leave empty on single-port PaaS hosts: the injected PORT
# (Render, Railway, Cloud Run) is used instead.
API_ADDR=
# Comma-separated browser origins allowed on the quote WS (empty = any;
# solver clients send no Origin and are unaffected — auth is signatures).
# No trailing slash — the Origin header is scheme://host only.
WS_ALLOWED_ORIGINS=https://lantern-five-virid.vercel.app
# Reference solver identity: the agent-owner key + the ERC-8004 agent id it
# quotes under. Both or neither — the solver stays disabled while empty.
REFERENCE_SOLVER_KEY=
REFERENCE_SOLVER_AGENT_ID=
# minOut guard for reference-solver quotes, in bps off quotedOut (default 50).
REFERENCE_SOLVER_SLIPPAGE_BPS=

# --- x402 paywall for GET /graph/snapshot (Phase 3) ---
# Open feed while X402_ASSET / X402_PAY_TO / X402_AMOUNT are all empty;
# all three must be set together (validated at startup).
# Facilitator default: https://facilitator.payai.network (supports
# avalanche-fuji exact — verified via GET /supported).
X402_FACILITATOR_URL=
# Network default: eip155:43113 (Avalanche Fuji, x402 v2 CAIP-2).
X402_NETWORK=
# Payment token (USDC on Fuji, from PayAI's live echo route):
# 0x5425890298aed601595a70AB815c96711a31Bc65
X402_ASSET=
# Merchant receiving address (0x-prefixed 20-byte).
X402_PAY_TO=
# Price in asset base units, decimal string (USDC 6 decimals:
# 10000 = 0.01 USDC). Must be > 0.
X402_AMOUNT=

# Phase 4 display feed: Hyperliquid prices + real-DEX graph config
# (services/market/marketdata.json — data, not secrets). Leave empty for
# the default path relative to services/market; a missing file only
# disables the /market endpoints, never the service.
MARKETDATA_FILE=

# Dual-registration mapping (our agent id → canonical ERC-8004 token id,
# written by contracts/script/DualRegister.s.sol — data, not secrets).
# Leave empty for the default path relative to services/market; a missing
# file only keeps Agent.canonicalTokenId null, never the service.
DUAL_REGISTRATION_FILE=
