# Lantern environment template.
# Copy to .env (gitignored — never commit real values).

# --- Backend API (apps/api) ---
PORT=4000

# --- Chat brains: OpenRouter (server-side only, never sent to the browser) ---
OPENROUTER_API_KEY=
CHAT_MODEL=openrouter/free

# --- Monad testnet: contracts deploy/seed scripts (contracts/script/) ---
# Chain ID is read from the RPC at run time (never hardcoded).
MONAD_TESTNET_RPC_URL=
MONAD_PRIVATE_KEY=
# Set after running Deploy.s.sol — the seeder reads it to know where to register.
AGENT_REGISTRY_ADDRESS=
