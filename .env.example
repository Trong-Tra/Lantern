# Lantern environment template.
# Copy to .env (gitignored — never commit real values).

# --- Envio feed (indexer deploy + services/market ingest) ---
# Envio HyperIndex GraphQL endpoint (hosted URL from Envio Console, or local `envio dev` URL).
ENVIO_GRAPHQL_URL
ENVIO_API_TOKEN
ENVIO_AVAX_FUJI_RPC_URL
ENVIO_ADMIN_SECRET

# --- Avalanche Fuji testnet (chain 43113): identity + market contracts ---
# Chain ID is read from the RPC at run time (never hardcoded).
AVAX_FUJI_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# Set after running Deploy.s.sol — the seeder reads AGENT_REGISTRY_ADDRESS to know where to register.
AGENT_REGISTRY_ADDRESS=
REPUTATION_ADDRESS=
# Set after running DeployMarket.s.sol.
LANTERN_MARKET_ADDRESS=

# --- Market service (services/market) — Phase 2 quote protocol ---
# Quote-protocol WebSocket listen address (default :8081).
MARKET_WS_ADDR=
# Reference solver identity: the agent-owner key + the ERC-8004 agent id it
# quotes under. Both or neither — the solver stays disabled while empty.
REFERENCE_SOLVER_KEY=
REFERENCE_SOLVER_AGENT_ID=
# minOut guard for reference-solver quotes, in bps off quotedOut (default 50).
REFERENCE_SOLVER_SLIPPAGE_BPS=
